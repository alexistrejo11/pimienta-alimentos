# Production environment template. Copy to backend/.env (never commit .env).
# Loaded by: docker compose -f docker-compose.prod.yml
# Local Compose (docker compose up) does not read this file; those values are hardcoded
# and point at Postgres/Redis/LocalStack on pimienta-net.

SPRING_PROFILES_ACTIVE=prod

# --- PostgreSQL (infra: postgres_central on infra_central_network) ---
POSTGRES_DB=pimienta_alimentos
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_URL=jdbc:postgresql://postgres_central:5432/pimienta_alimentos

# --- Redis (infra: redis-central on infra_central_network) ---
REDIS_URL=redis://default:CHANGE_ME@redis-central:6379/
PIMIENTA_REDIS_KEY_PREFIX=pimienta-alimentos

# CORS — browser origins only (no trailing slash)
PIMIENTA_CORS_ALLOWED_ORIGINS=https://pimienta-alimentos.com,https://www.pimienta-alimentos.com,http://localhost:4002

# Tunnel-assigned host/container port (must stay 8027)
API_PORT=8027

# JWT — long random secret (HS256, ≥256 bits)
PIMIENTA_SECURITY_JWT_SECRET=
JAVA_OPTS=

# AWS S3 (real AWS in prod — leave endpoints empty)
AWS_REGION=us-east-1
AWS_S3_FOLDER=app
AWS_S3_SOURCES_ROOT=pimienta
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_ENDPOINT=
AWS_S3_POS_APK_KEY=pimienta/releases/pos/android/latest.apk
AWS_S3_POS_APK_MANIFEST_KEY=pimienta/releases/pos/android/current.json
