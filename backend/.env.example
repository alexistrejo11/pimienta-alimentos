# Copy to backend/.env. Compose loads this automatically from backend/.
#   docker compose up --build
# For host `./mvnw spring-boot:run` / IDE, DotenvEnvironmentPostProcessor loads the same file.
# Set SPRING_PROFILES_ACTIVE=dev. Compose injects in-network Postgres/Redis/LocalStack URLs
# on the api service; the host values below are for Maven/IDE against published ports.

SPRING_PROFILES_ACTIVE=dev

# --- PostgreSQL ---
POSTGRES_DB=pimienta_alimentos
POSTGRES_USER=pimienta_dba
POSTGRES_PASSWORD=pimienta_dba
POSTGRES_PORT=5431
# Host / IDE (Compose publishes 5431). Compose api service overrides with postgres:5432.
POSTGRES_URL=jdbc:postgresql://localhost:5431/pimienta_alimentos

# --- Redis ---
# Host / IDE: published 6378. Compose api service overrides with redis:6379.
REDIS_URL=redis://localhost:6378

PIMIENTA_REDIS_KEY_PREFIX=pimienta-alimentos

# CORS — comma-separated SPA origins (no trailing slash)
PIMIENTA_CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:4001,http://localhost:3000,http://127.0.0.1:4000,http://127.0.0.1:4001,http://127.0.0.1:3000

# API
API_PORT=8080

# JWT — set a long random secret in production
PIMIENTA_SECURITY_JWT_SECRET=change-me-use-at-least-256-bits-for-hs256-secret-key-pimienta

JAVA_OPTS=

# AWS / LocalStack (dev). Compose api uses http://localstack:4566 and public http://localhost:4566.
AWS_REGION=us-east-1
AWS_S3_FOLDER=employees
AWS_S3_SOURCES_ROOT=pimienta/sources
AWS_S3_BUCKET_NAME=pimienta-employees
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_ENDPOINT=http://localhost:4566
AWS_S3_PUBLIC_ENDPOINT=http://localhost:4566
