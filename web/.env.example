# Browser-reachable API base (not a Docker-internal hostname). Use http, not https.
# backend/docker-compose.yml publishes the API on localhost:8000.
# Local Spring Boot without Compose still defaults to localhost:8080.
API_BASE_URL=http://localhost:8000/api/v1

# Comma-separated hosts allowed by Angular SSR (Host header / SSRF checks).
ALLOWED_HOSTS=localhost,127.0.0.1

# Host port mapped to the container SSR server.
PORT=4000
